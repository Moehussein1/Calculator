<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator.MainPage"
             Title="Calculator"
             BackgroundColor="#1E1E1E">

    <Grid RowDefinitions="Auto,Auto,*,*,*,*,*"
          ColumnDefinitions="*,*,*,*"
          Padding="10"
          RowSpacing="6"
          ColumnSpacing="6">

        <!-- Display beräkningar -->
        <Entry x:Name="EntryCalculations"
               Grid.Row="0"
               Grid.ColumnSpan="4"
               IsReadOnly="True"
               FontSize="18"
               BackgroundColor="#2D2D2D"
               TextColor="LightGray"
               HorizontalTextAlignment="End"
               Margin="0,0,0,5"/>

        <!-- Display resultat -->
        <Entry x:Name="EntryResult"
               Grid.Row="1"
               Grid.ColumnSpan="4"
               IsReadOnly="True"
               FontSize="36"
               BackgroundColor="#2D2D2D"
               TextColor="White"
               HorizontalTextAlignment="End"
               Text="0"
               Margin="0,0,0,10"/>

        <!-- Rad 1 -->
        <Button Text="C" Grid.Row="2" Grid.Column="0" Clicked="ClearButton" BackgroundColor="#FF5C5C"/>
        <Button Text="M+" Grid.Row="2" Grid.Column="1" Clicked="StoreInMemoryButton" BackgroundColor="#3A3A3A" TextColor="White"/>
        <Button Text="M-" Grid.Row="2" Grid.Column="2" Clicked="CatchFromMemoryButton" BackgroundColor="#3A3A3A" TextColor="White"/>
        <Button Text="/" Grid.Row="2" Grid.Column="3" Clicked="OperatorButton" BackgroundColor="#FF9500"/>

        <!-- Rad 2 -->
        <Button Text="7" Grid.Row="3" Grid.Column="0" Clicked="NumberButton" BackgroundColor="#505050"/>
        <Button Text="8" Grid.Row="3" Grid.Column="1" Clicked="NumberButton" BackgroundColor="#505050"/>
        <Button Text="9" Grid.Row="3" Grid.Column="2" Clicked="NumberButton" BackgroundColor="#505050"/>
        <Button Text="*" Grid.Row="3" Grid.Column="3" Clicked="OperatorButton" BackgroundColor="#FF9500"/>

        <!-- Rad 3 -->
        <Button Text="4" Grid.Row="4" Grid.Column="0" Clicked="NumberButton" BackgroundColor="#505050"/>
        <Button Text="5" Grid.Row="4" Grid.Column="1" Clicked="NumberButton" BackgroundColor="#505050"/>
        <Button Text="6" Grid.Row="4" Grid.Column="2" Clicked="NumberButton" BackgroundColor="#505050"/>
        <Button Text="-" Grid.Row="4" Grid.Column="3" Clicked="OperatorButton" BackgroundColor="#FF9500"/>

        <!-- Rad 4 -->
        <Button Text="1" Grid.Row="5" Grid.Column="0" Clicked="NumberButton" BackgroundColor="#505050"/>
        <Button Text="2" Grid.Row="5" Grid.Column="1" Clicked="NumberButton" BackgroundColor="#505050"/>
        <Button Text="3" Grid.Row="5" Grid.Column="2" Clicked="NumberButton" BackgroundColor="#505050"/>
        <Button Text="+" Grid.Row="5" Grid.Column="3" Clicked="OperatorButton" BackgroundColor="#FF9500"/>

        <!-- Rad 5 -->
        <Button Text="0"
                Grid.Row="6"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Clicked="NumberButton"
                BackgroundColor="#505050"
                HorizontalOptions="FillAndExpand"/>

        <Button Text=","
                Grid.Row="6"
                Grid.Column="2"
                Clicked="DecimalButton"
                BackgroundColor="#505050"/>

        <Button Text="="
                Grid.Row="6"
                Grid.Column="3"
                Clicked="EqualButton"
                BackgroundColor="#FF9500"/>

        </Grid>
</ContentPage>